; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Projeto 8.26"
run/main_scene="uid://bqevk7iunmrs4"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Inventario="*uid://6uj7q84uo5k6"
RevealNameEffect="*res://scripts/reveal_name_effect.gd"
DialogicBridge="*res://scripts/dialogic_bridge.gd"
Interacao="*res://scripts/interacao.gd"
Progresso="*res://scripts/progresso.gd"
FerramentasHUD="*res://scripts/ui/ferramentas_hud.gd"
Dialogic="*uid://c3b5clqd5sgir"

[dialogic]

directories/dch_directory={
"cacau": "res://timelines/cacau.dch",
"cientista": "res://timelines/cientista.dch"
}
directories/dtl_directory={
"cacau_ve_foguete": "res://timelines/cacau_ve_foguete.dtl",
"cientista_dica_balanceamento": "res://timelines/cientista_dica_balanceamento.dtl",
"cientista_dica_equacao_dobrada": "res://timelines/cientista_dica_equacao_dobrada.dtl",
"cientista_dica_sem_itens": "res://timelines/cientista_dica_sem_itens.dtl",
"cientista_dica_tem_ambos": "res://timelines/cientista_dica_tem_ambos.dtl",
"cientista_dica_tem_h2": "res://timelines/cientista_dica_tem_h2.dtl",
"cientista_dica_tem_o2": "res://timelines/cientista_dica_tem_o2.dtl",
"cientista_fase1": "res://timelines/cientista_fase1.dtl",
"cientista_final_fase": "res://timelines/cientista_final_fase.dtl",
"cientista_laser_aberto": "res://timelines/cientista_laser_aberto.dtl",
"jaleco": "res://timelines/jaleco.dtl",
"samambaia": "res://timelines/samambaia.dtl",
"simulador_derrota": "res://timelines/simulador_derrota.dtl",
"simulador_ligar": "res://timelines/simulador_ligar.dtl",
"simulador_ligar_de_novo": "res://timelines/simulador_ligar_de_novo.dtl",
"simulador_saida": "res://timelines/simulador_saida.dtl",
"simulador_vitoria": "res://timelines/simulador_vitoria.dtl"
}
glossary/default_case_sensitive=true
variables={
"reveal_name": "Desconhecido"
}

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=3
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

